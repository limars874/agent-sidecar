{
  "name": "agent-sidecar",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "description": "Run configurable side work (titles, summaries, knowledge candidates) alongside AI coding agent sessions, on a cheaper model",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "agent-sidecar": "bin/agent-sidecar.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "pi": {
    "extensions": [
      "./adapters/pi/extension.js"
    ]
  },
  "dependencies": {
    "@nats-io/nats-core": "~3.3.1",
    "@nats-io/transport-node": "~3.3.1",
    "yaml": "^2.6.0"
  }
}
